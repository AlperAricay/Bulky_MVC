@model IEnumerable<Product>

<div class="row pb-3">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="row p-2">
                <div class="col-12 p-1">
                    <div class="card border-0 p-3 shadow border-top border-5 rounded">
                        <img src="@product.ImageUrl" class="card-img-top rounded" alt="Product Image"/>
                        <div class="card-body pb-0">
                            <div class="p-lg-0">
                                <p class="card-text text-uppercase text-xl-center mb-0">@product.Title</p>
                                <p class="card-text text-warning text-center">by <b>@product.Author</b></p>
                            </div>
                            <div class="p-lg-2">
                                <p class="card-text text-xl-center mb-0">
                                    List Price:
                                    <span class="text-decoration-line-through">
                                        @product.ListPrice.ToString("C")
                                    </span>
                                </p>
                                <p class="card-text text-xl-center">
                                    As low as:
                                    <span>
                                        @product.Price100.ToString("C")
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div>
                            <a asp-action="Details"
                               asp-route-productId="@product.Id"
                               class="btn btn-primary bg-gradient border-0 form-control">
                                Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>