@model int

<div class="container row pt-4">
    <div class="col-12 text-center">
        <h1 class="text-primary text-center">Order Placed Successfully!</h1>
        Order Number: @Model.ToString() <br/><br/>
        <img src="~/images/lawn_leaf.jpg" width="65%" alt="Success Image"/>
    </div>
    <div class="col-12 text-center" style="color:maroon">
        <br/>
        Your payment was successful! <br/>
        <a asp-area="Admin"
           asp-controller="Order"
           asp-action="Details"
           asp-route-orderId="@Model" class="btn btn-primary">
            Back to Order Details
        </a>
    </div>

</div>